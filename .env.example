# SQLite by default. Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./fish_journal.db

# --- Authentication (required) ---
# Random string, 32+ characters. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Local development ONLY. Turns authentication off. Never set on a server.
AUTH_DISABLED=false

# Comma separated origins, or * . Mobile apps ignore CORS; restrict if you add a web client.
CORS_ORIGINS=*
# Serve /docs and /openapi.json (off by default)
ENABLE_DOCS=false
